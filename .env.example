# Orbit — copy to backend/.env and fill in values (never commit .env)

# ── Django ────────────────────────────────────────────────────────────────────
# Required: generate with `python -c "import secrets; print(secrets.token_hex(50))"`
SECRET_KEY=

# Set to True only in local development
DEBUG=False

# Comma-separated list of allowed hostnames (no protocol/port)
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Clerk authentication ──────────────────────────────────────────────────────
# RS256 public key from Clerk Dashboard → API Keys → JWT public key
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\\n-----END PUBLIC KEY-----

# Issuer URL from Clerk Dashboard (e.g. https://your-app.clerk.accounts.dev)
CLERK_ISSUER=https://glad-magpie-67.clerk.accounts.dev

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# Use LocalStack for local dev: docker compose up
AWS_S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=orbit-local

# ── File uploads ─────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default: 100 MB)
MAX_UPLOAD_BYTES=100000000

# ── Worker / queue (future) ───────────────────────────────────────────────────
# CELERY_BROKER_URL=redis://localhost:6379/0

# ── LLM / extraction (future) ────────────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
