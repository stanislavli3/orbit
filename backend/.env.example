SECRET_KEY=replace-with-output-of--python-c-"import secrets; print(secrets.token_hex(50))"
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Clerk — Dashboard → API Keys
# JWT public key: Dashboard → API Keys → "Show JWT public key" → paste the single-line PEM
# Issuer: shown on the same page, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# CORS — add all frontend origins (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# S3 — LocalStack for local dev (matches docker-compose.yml)
AWS_S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=orbit-local

# AI descriptions — optional, upload works without it
ANTHROPIC_API_KEY=sk-ant-...

# Celery broker — Redis from docker-compose.yml (`make dev` starts it)
CELERY_BROKER_URL=redis://localhost:6379/0
